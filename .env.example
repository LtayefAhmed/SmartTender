# =============================================================================
# SmartTender AI — Ingestion platform environment
# Copy to `.env` and adjust. Every value has a safe default in code except
# the secrets, which MUST be overridden outside of local development.
# =============================================================================

# --- Runtime ----------------------------------------------------------------
SMARTTENDER_ENV=development                 # development | staging | production
SMARTTENDER_DEBUG=true
SMARTTENDER_LOG_LEVEL=INFO
SMARTTENDER_LOG_FORMAT=console              # console | json  (use json in prod)
SMARTTENDER_CONFIG_DIR=./config

# --- API --------------------------------------------------------------------
SMARTTENDER_API__HOST=0.0.0.0
SMARTTENDER_API__PORT=8000
SMARTTENDER_API__ROOT_PATH=
SMARTTENDER_API__CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
SMARTTENDER_API__API_KEYS=["dev-local-key"]

# --- PostgreSQL -------------------------------------------------------------
SMARTTENDER_DB__HOST=localhost
SMARTTENDER_DB__PORT=5432
SMARTTENDER_DB__USER=smarttender
SMARTTENDER_DB__PASSWORD=change-me
SMARTTENDER_DB__NAME=smarttender
SMARTTENDER_DB__POOL_SIZE=10
SMARTTENDER_DB__MAX_OVERFLOW=20
SMARTTENDER_DB__ECHO=false

# --- Redis (Celery broker + result backend + rate limiter) ------------------
SMARTTENDER_REDIS__HOST=localhost
SMARTTENDER_REDIS__PORT=6379
SMARTTENDER_REDIS__PASSWORD=
SMARTTENDER_REDIS__BROKER_DB=0
SMARTTENDER_REDIS__RESULT_DB=1
SMARTTENDER_REDIS__CACHE_DB=2

# --- MinIO / S3 -------------------------------------------------------------
SMARTTENDER_STORAGE__ENDPOINT=localhost:9000
SMARTTENDER_STORAGE__ACCESS_KEY=minioadmin
SMARTTENDER_STORAGE__SECRET_KEY=change-me
SMARTTENDER_STORAGE__SECURE=false
SMARTTENDER_STORAGE__BUCKET=smarttender-documents
SMARTTENDER_STORAGE__REGION=us-east-1
SMARTTENDER_STORAGE__SERVER_SIDE_ENCRYPTION=true
SMARTTENDER_STORAGE__PRESIGNED_TTL_SECONDS=900

# --- Upload validation ------------------------------------------------------
SMARTTENDER_UPLOAD__MAX_BYTES=26214400      # 25 MB
SMARTTENDER_UPLOAD__ALLOWED_EXTENSIONS=[".pdf",".docx",".html",".htm"]

# --- Notifications (SMTP) ---------------------------------------------------
SMARTTENDER_NOTIFICATIONS__EMAIL_ENABLED=false
SMARTTENDER_NOTIFICATIONS__SMTP_HOST=localhost
SMARTTENDER_NOTIFICATIONS__SMTP_PORT=1025
SMARTTENDER_NOTIFICATIONS__SMTP_USER=
SMARTTENDER_NOTIFICATIONS__SMTP_PASSWORD=
SMARTTENDER_NOTIFICATIONS__SMTP_TLS=false
SMARTTENDER_NOTIFICATIONS__FROM_ADDRESS=smarttender@example.com

# --- Connector credentials --------------------------------------------------
# TUNEPS is a free public portal — no credentials required.
# J360 requires a paid subscription; leave blank to keep the connector disabled.
SMARTTENDER_CONNECTOR_J360_USERNAME=
SMARTTENDER_CONNECTOR_J360_PASSWORD=
SMARTTENDER_CONNECTOR_J360_API_KEY=

# --- Proxy (optional, disabled by default) ----------------------------------
SMARTTENDER_PROXY__ENABLED=false
SMARTTENDER_PROXY__URLS=[]

# --- Semantic backend -------------------------------------------------------
# lexical  : pure-python char-ngram + token Jaccard (zero dependencies, default)
# minilm   : ONNX all-MiniLM-L6-v2 (requires the `semantic` extra + model file)
SMARTTENDER_SEMANTIC__BACKEND=lexical

# --- LLM (Mistral) ------------------------------------------------------------
# Refines what the deterministic pipeline could not: garbled OCR, and turning a
# CCTP's prose into structured requirements. Left empty, every LLM step is
# skipped and the platform behaves exactly as before — the pass is an
# improvement, never a dependency.
#
# SOVEREIGNTY. Calling this API sends text to a third party. Tender notices are
# public and lose nothing by it; CVs are personal data, and the architecture
# reference states that CVs never leave the server (RGPD / INPDP). `SCOPE` is
# what enforces the distinction.
SMARTTENDER_LLM__MISTRAL_API_KEY=
# tenders | tenders_and_cvs | off
SMARTTENDER_LLM__SCOPE=tenders_and_cvs
SMARTTENDER_LLM__MODEL=mistral-small-latest
SMARTTENDER_LLM__TIMEOUT_SECONDS=30
SMARTTENDER_LLM__MAX_INPUT_CHARS=12000
SMARTTENDER_SEMANTIC__MODEL_PATH=./models/all-MiniLM-L6-v2
