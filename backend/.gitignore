.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# Secrets — only the example is tracked.
# `.env.example` contains placeholders only and is the onboarding template, so
# it stays in version control. `.env` holds the real values and never does.
.env
.env.local
.env.*.local

# Downloaded ONNX model weights — `SemanticSettings.model_path` defaults to
# ./models/all-MiniLM-L6-v2, relative to this directory.
#
# The leading slash is load-bearing. Written as `models/`, the pattern matches
# a directory of that name at *any* depth, and it silently swallowed
# `app/db/models/` — every ORM model in the project. Nothing failed: `git add`
# skipped them, `git status` never listed them, and the repository has never
# contained a table definition. A fresh clone could not start the application.
/models/

data/
logs/
*.log

.idea/
.vscode/
.DS_Store

# TLS client certificates (TUNTRUST) — never commit these.
certs/*
!certs/.gitkeep
